APP_NAME="WS Clean & Laundry Serviços, Lda"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=pt
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=pt_PT

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

# MySQL 8 / MariaDB (InnoDB). SQLite is not supported.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=washly-lavandaria
DB_USERNAME=root
DB_PASSWORD=

# mysqldump for backups (full path when it is not on the PATH).
MYSQLDUMP_PATH=mysqldump

SESSION_DRIVER=database
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="laundry@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# WhatsApp: conversations channel (log = test mode, cloud = official API, web = free QR connection)
WHATSAPP_DRIVER=log
# Automatic notifications: cloud or log (empty = same as WHATSAPP_DRIVER; with web they are off)
WHATSAPP_NOTIFICATIONS_DRIVER=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_TEMPLATE_LANGUAGE=pt_PT
# Free QR connection (service in whatsapp-web/, run: cd whatsapp-web && npm install && npm start)
WHATSAPP_WEB_URL=http://127.0.0.1:3010
WHATSAPP_WEB_TOKEN=
# Choosing "QR code" in the settings starts the service; false = run it yourself (pm2, systemd, NSSM).
WHATSAPP_WEB_AUTOSTART=true
# Path to node when the web server does not find it (e.g. C:\Program Files\nodejs\node.exe).
WHATSAPP_WEB_NODE=
# Where the QR service posts customer messages (default: APP_URL/webhooks/whatsapp-web)
WHATSAPP_WEB_WEBHOOK=
